{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@clinica/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
